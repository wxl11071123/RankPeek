#!/usr/bin/env bash
set -Eeuo pipefail

DATABASE_NAME="${RANKPEEK_BACKUP_DATABASE_NAME:-rankpeek_server}"
BACKUP_DIR="${RANKPEEK_BACKUP_DIR:-/var/backups/rankpeek/postgres}"
RETENTION_DAYS="${RANKPEEK_BACKUP_RETENTION_DAYS:-14}"
TIMESTAMP="$(date -u +%Y%m%dT%H%M%SZ)"
BACKUP_PATH="${BACKUP_DIR}/${DATABASE_NAME}-${TIMESTAMP}.dump"
CHECKSUM_PATH="${BACKUP_PATH}.sha256"

log() {
  printf '[rankpeek-backup] %s\n' "$1"
}

mkdir -p "$BACKUP_DIR"
chmod 750 "$BACKUP_DIR"

log "Writing PostgreSQL custom-format backup to ${BACKUP_PATH}"
pg_dump \
  --format=custom \
  --blobs \
  --no-owner \
  --file "$BACKUP_PATH" \
  "$DATABASE_NAME"

chmod 640 "$BACKUP_PATH"
sha256sum "$BACKUP_PATH" > "$CHECKSUM_PATH"
chmod 640 "$CHECKSUM_PATH"

log "Deleting backups older than ${RETENTION_DAYS} days"
find "$BACKUP_DIR" -type f \( -name "${DATABASE_NAME}-*.dump" -o -name "${DATABASE_NAME}-*.dump.sha256" \) -mtime +"$RETENTION_DAYS" -delete

log "Backup complete"
