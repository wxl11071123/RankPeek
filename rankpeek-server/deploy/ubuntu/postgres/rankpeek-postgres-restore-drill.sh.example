#!/usr/bin/env bash
set -Eeuo pipefail

BACKUP_FILE="${1:-}"
DRILL_DB="${RANKPEEK_RESTORE_DRILL_DB:-rankpeek_restore_drill}"
KEEP_DRILL_DB="${RANKPEEK_RESTORE_KEEP_DRILL_DB:-false}"

usage() {
  printf 'Usage: %s /var/backups/rankpeek/postgres/rankpeek_server-YYYYmmddTHHMMSSZ.dump\n' "$0" >&2
}

log() {
  printf '[rankpeek-restore-drill] %s\n' "$1"
}

cleanup() {
  if [[ "$KEEP_DRILL_DB" != "true" ]]; then
    dropdb --if-exists "$DRILL_DB" >/dev/null 2>&1 || true
  fi
}

if [[ -z "$BACKUP_FILE" ]]; then
  usage
  exit 2
fi

if [[ ! -f "$BACKUP_FILE" ]]; then
  printf '[rankpeek-restore-drill] ERROR: backup file not found: %s\n' "$BACKUP_FILE" >&2
  exit 1
fi

trap cleanup EXIT

log "Recreating drill database ${DRILL_DB}"
dropdb --if-exists "$DRILL_DB"
createdb "$DRILL_DB"

log "Restoring ${BACKUP_FILE} into ${DRILL_DB}"
pg_restore \
  --clean \
  --if-exists \
  --no-owner \
  --dbname "$DRILL_DB" \
  "$BACKUP_FILE"

FLYWAY_VERSION="$(
  psql --dbname "$DRILL_DB" --tuples-only --no-align \
    --command "select version from flyway_schema_history where success = true order by installed_rank desc limit 1;"
)"

if [[ -z "$FLYWAY_VERSION" ]]; then
  printf '[rankpeek-restore-drill] ERROR: restored database has no successful Flyway version\n' >&2
  exit 1
fi

log "Restore drill succeeded at Flyway version ${FLYWAY_VERSION}"
if [[ "$KEEP_DRILL_DB" == "true" ]]; then
  log "Keeping drill database ${DRILL_DB} because RANKPEEK_RESTORE_KEEP_DRILL_DB=true"
fi
