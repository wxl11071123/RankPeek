# Install as /etc/nginx/snippets/rankpeek-proxy-headers.conf.
# This snippet intentionally normalizes X-Forwarded-For to Nginx's direct
# client address. Do not append untrusted forwarded chains unless an outer
# trusted load balancer has already stripped untrusted client headers.
proxy_http_version 1.1;
proxy_set_header Host $host;
proxy_set_header X-Real-IP $remote_addr;
proxy_set_header X-Forwarded-For $remote_addr;
proxy_set_header X-Forwarded-Proto $scheme;
proxy_set_header X-Forwarded-Host $host;
proxy_set_header X-Request-Id $request_id;
proxy_set_header Connection "";
proxy_connect_timeout 5s;
proxy_send_timeout 75s;
proxy_read_timeout 75s;
